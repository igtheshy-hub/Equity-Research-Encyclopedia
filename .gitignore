# 密钥（安全红线，绝不入库）
.env

# 知识库内容层：原始资料有版权，wiki 页面是个人库编译产物；
# fork 者得到的是空知识库，自行摄入自建
raw/
wiki/

# 运行状态层：问答会话历史、摄入清单、结构化财报、取数来源缓存、模型日志，全部本地生成
data/

# 报告产出：成品密集引用库内研报数据，且含 Word/图表二进制，不入库
outputs/

# 浏览器自动化调试产物
.playwright-mcp/
report-after-reload.yml

# Python
__pycache__/
*.pyc

# 系统杂项
.DS_Store
Thumbs.db

# 改代码前的本地备份
.backup-*/
