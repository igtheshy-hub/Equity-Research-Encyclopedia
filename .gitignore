# 密钥（安全红线，绝不入库）
.env

# 原始资料：研报/财报/政策原文有版权，不入公开仓库
raw/
data/reports/
data/exports/
data/pdf_cache/

# 每个人的知识库与运行数据都是本地私有的：新克隆后应为空，
# 不把别人的 wiki、会话、日志、材料清单带进来
wiki/
data/
outputs/

# 本地运行日志与虚拟环境
*.log
.venv/
*.egg-info/
.pytest_cache/

# 运行期数据库与缓存（本地状态，不该进仓库）
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm

# 网页本地运行状态（收件台/摄入页的最近结果）
data/ui_state.json

# 运行期产物：审校输出、报告生成物、锚点复核清单、模型调用流水
outputs/
data/anchor_review.json
data/llm_log.jsonl

# 日志（网页服务与摄入流水线的运行日志）
*.log
logs/

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
.venv/
venv/
env/

# pytest（跑一次就生成一堆缓存文件）
.pytest_cache/

# 系统杂项
.DS_Store
Thumbs.db

# 改代码前的本地备份
.backup-*/
