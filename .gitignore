# 密钥（安全红线，绝不入库）
.env

# 知识库内容层：原始资料有版权，wiki 页面是个人库编译产物；
# fork 者得到的是空知识库，自行摄入自建
raw/
wiki/

# 每个人的知识库与运行数据都是本地私有的：新克隆后应为空，
# 不把别人的 wiki、会话、日志、材料清单带进来
data/

# 报告产出：成品密集引用库内研报数据，且含 Word/图表二进制，不入库
outputs/

# 浏览器自动化调试产物
.playwright-mcp/
report-after-reload.yml

# 运行期产物：审校输出、报告生成物、锚点复核清单、模型调用流水
outputs/
data/anchor_review.json
data/llm_log.jsonl

# 日志（网页服务与摄入流水线的运行日志）
*.log
logs/

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
.venv/
venv/
env/

# pytest（跑一次就生成一堆缓存文件）
.pytest_cache/

# 系统杂项
.DS_Store
Thumbs.db

# 改代码前的本地备份
.backup-*/
