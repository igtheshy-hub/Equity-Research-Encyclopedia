# 密钥（安全红线，绝不入库）
.env

# 原始资料：研报/财报/政策原文有版权，不入公开仓库
raw/

# 提取中间产物：含研报全文文本，同上
data/extracts/

# 网页本地运行状态（收件台/摄入页的最近结果）
data/ui_state.json

# 行业研报任务状态与转 Word 中间产物
data/report_jobs/
data/_display-*

# 报告产出：成品密集引用库内研报数据，且含 Word/图表二进制，不入库
outputs/

# 浏览器自动化调试产物
.playwright-mcp/
report-after-reload.yml

# Python
__pycache__/
*.pyc

# 系统杂项
.DS_Store
Thumbs.db

# 改代码前的本地备份
.backup-*/
