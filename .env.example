# ===== 通用 =====
WIKI_DATA_DIR=C:/Users/Administrator/research-wiki/data
WIKI_DB_PATH=C:/Users/Administrator/research-wiki/data/wiki.sqlite
WIKI_HOST=127.0.0.1
WIKI_PORT=5000

# 团队可选密码留空不强制登录；填了就在 /ingest /audit 上要求登录
WIKI_ADMIN_PASSWORD=

# ===== LLM =====
# claude | openai_compat
LLM_PROVIDER=claude
# 默认 Claude 模型
LLM_DEFAULT_MODEL=claude-3-5-sonnet-latest
# 备用模型：当主模型失败时降级
LLM_FALLBACK_MODEL=claude-3-haiku-20240307

# Claude（Anthropic）API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI 兼容（DeepSeek / 通义 / Kimi / 本地 vllm 都吃这个）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=claude-3-5-sonnet-latest   # 仅在 LLM_PROVIDER=openai_compat 时生效

# 智谱 GLM（与 Igshy 主仓默认一致；改 LLM_PROVIDER=zhipu 即可走这家）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6

# ===== PDF =====
# 文字层字符数 < 该阈值视为扫描件走 OCR
WIKI_OCR_TEXT_LAYER_THRESHOLD=30
# 一页超过该字符数则截断（防巨型 PDF）
WIKI_PAGE_TEXT_MAX_CHARS=20000
# 关掉 OCR（Python 3.14 / 无 paddleocr 时）
WIKI_ENABLE_OCR=true
WIKI_OCR_ENGINE=paddleocr   # paddleocr | tesseract
WIKI_OCR_LANG=ch

# ===== 检索 =====
WIKI_FTS_CANDIDATE_LIMIT=30
WIKI_RETRIEVAL_FINAL_K=8
# 启用向量召回（首版可关）
WIKI_ENABLE_EMBEDDING=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 审校 =====
WIKI_AUDIT_CRON_HOUR=2
WIKI_AUDIT_CRON_MINUTE=30
WIKI_AUDIT_ISOLATED_DAYS=90

# ===== 日志 =====
WIKI_LOG_LEVEL=INFO
